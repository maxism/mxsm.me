{
  "name": "mxsm-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:palette": "node scripts/build-palette.mjs",
    "build:mediapipe": "node scripts/copy-mediapipe.mjs",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "prebuild": "npm run build:palette && npm run build:mediapipe",
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint src",
    "typecheck": "npm exec --yes --package=typescript@7 -- tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "fast-xml-parser": "^5.8.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.5",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}
